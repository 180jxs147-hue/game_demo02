; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="时空阵线"
run/main_scene="res://Scenes/MainMenu.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://AutoLoad/EventBus.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
GridManager="*res://Scripts/GridManager.gd"
GameState="*res://AutoLoad/GameState.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/godot_state_charts/plugin.cfg")
