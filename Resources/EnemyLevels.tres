[ext_resource type="Resource" path="res://Resources/DataFiles/soldier.tres" id="4_soldier"]
[ext_resource type="Resource" path="res://Resources/DataFiles/Pyrrhus.tres" id="5_pyrrhus"]

[sub_resource type="Resource" script_class="UnitSpawn" id="UnitSpawn_1"]
