[resource]
script = ExtResource("1_level")
level_id = "1_2_6"
level_name = "黄巾线 第 6 关 - 广宗前线"
grid_width = 9
grid_height = 6
enemy_units = Array[ExtResource("2_spawn")]([SubResource("UnitSpawn_1"), SubResource("UnitSpawn_Add1"), SubResource("UnitSpawn_Add2"), SubResource("UnitSpawn_Add3"), SubResource("UnitSpawn_Add4"), SubResource("UnitSpawn_Add5")])
