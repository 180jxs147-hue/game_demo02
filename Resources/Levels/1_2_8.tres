[gd_resource type="Resource" script_class="LevelConfig" format=3]

[ext_resource type="Script" path="res://Resources/LevelConfig.gd" id="1_level"]
[ext_resource type="Script" path="res://Resources/UnitSpawn.gd" id="2_spawn"]
[ext_resource type="Resource" path="res://Resources/DataFiles/huangfu_song.tres" id="3_huangfu"]
[ext_resource type="Resource" path="res://Resources/DataFiles/yulin_lang.tres" id="4_yulin"]
[ext_resource type="Resource" path="res://Resources/DataFiles/sanhe_qishi.tres" id="5_sanhe"]
[ext_resource type="Resource" path="res://Resources/DataFiles/shesheng_shi.tres" id="6_shesheng"]

[sub_resource type="Resource" id="UnitSpawn_Boss"]
script = ExtResource("2_spawn")
unit_data = ExtResource("3_huangfu")
grid_pos = Vector2i(4, 1)

[sub_resource type="Resource" id="UnitSpawn_Guard1"]
script = ExtResource("2_spawn")
unit_data = ExtResource("4_yulin")
grid_pos = Vector2i(3, 2)

[sub_resource type="Resource" id="UnitSpawn_Guard2"]
script = ExtResource("2_spawn")
unit_data = ExtResource("4_yulin")
grid_pos = Vector2i(6, 2)

[sub_resource type="Resource" id="UnitSpawn_Cav1"]
script = ExtResource("2_spawn")
unit_data = ExtResource("5_sanhe")
grid_pos = Vector2i(2, 1)

[sub_resource type="Resource" id="UnitSpawn_Cav2"]
script = ExtResource("2_spawn")
unit_data = ExtResource("5_sanhe")
grid_pos = Vector2i(6, 1)

[sub_resource type="Resource" id="UnitSpawn_Archer"]
script = ExtResource("2_spawn")
unit_data = ExtResource("6_shesheng")
grid_pos = Vector2i(4, 0)

[resource]
script = ExtResource("1_level")
level_id = "1_2_8"
level_name = "黄巾线 第 8 关 - 广宗决战"
grid_width = 9
grid_height = 6
enemy_manpower_regen = 6.8
enemy_units = Array[ExtResource("2_spawn")]([SubResource("UnitSpawn_Boss"), SubResource("UnitSpawn_Guard1"), SubResource("UnitSpawn_Guard2"), SubResource("UnitSpawn_Cav1"), SubResource("UnitSpawn_Cav2"), SubResource("UnitSpawn_Archer")])
reward_pool_id = "huangjin_late"
shop_pool_id = "huangjin_shop"
