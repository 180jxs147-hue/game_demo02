[resource]
script = ExtResource("1_db")
units = Array[Resource]([
    ExtResource("9_soldier"), ExtResource("23_junguo"), ExtResource("10_spear"), ExtResource("27_yulin"), 
    ExtResource("3_archer"), ExtResource("26_shesheng"), ExtResource("8_shield"), ExtResource("5_cavalry"), 
    ExtResource("24_sanhe"), ExtResource("25_changshui"), ExtResource("4_catapult"), ExtResource("6_farmer"), 
    ExtResource("7_quarter"), ExtResource("19_cangtian"), ExtResource("20_hj_lishi"), ExtResource("21_taiping"), 
    ExtResource("22_ezei"), ExtResource("2_pyrrhus"), ExtResource("11_xiang"), 
    ExtResource("14_sun"), ExtResource("15_leo"), ExtResource("16_alex"), ExtResource("17_caesar"), 
    ExtResource("18_camp"), ExtResource("28_drum"), ExtResource("29_cart"), ExtResource("30_tower"), 
    ExtResource("31_bocai"), ExtResource("32_caocao"), ExtResource("33_danyang"), ExtResource("34_guanyu"), 
    ExtResource("35_liubei"), ExtResource("36_mayuanyi"), ExtResource("37_sunjian"), ExtResource("38_zhangbao"), 
    ExtResource("39_zhangfei"), ExtResource("40_zhangjiao"), ExtResource("41_zhangliang"),
    ExtResource("42_joan"), ExtResource("43_prince"), ExtResource("44_lahire"), ExtResource("45_chandos"),
    ExtResource("46_routier"), ExtResource("47_billman"), ExtResource("48_hobilar"), ExtResource("49_knight"),
    ExtResource("50_rib"), ExtResource("51_culverin"), ExtResource("52_gunner")
])
story_by_path = {
"res://Resources/DataFiles/camp.tres": "军中休憩之所，亦是补给流转的核心。\n源源不断地提供支持，是持久战的关键。",
"res://Resources/DataFiles/Pyrrhus.tres": "卧薪尝胆，以弱胜强。\n他并非天生强大，而是愿意承受屈辱与牺牲。",
"res://Resources/DataFiles/archer.tres": "弓弦一响，远处便有人倒下。\n他们不擅长坚守，却擅长把敌人逼进恐惧。",
"res://Resources/DataFiles/catapult.tres": "巨石飞过，城墙与意志一起碎裂。\n每一次装填，都是把未来投向远方。",
"res://Resources/DataFiles/cavalry.tres": "马蹄落地，战场就开始重新书写。\n骑兵不擅长等待，他们只擅长突破。",
"res://Resources/DataFiles/farmer.tres": "耕作、修补、搬运。\n他们不站在战线的最前，却撑起了所有人的后方。",
"res://Resources/DataFiles/quarter.tres": "不显于锋刃，却决定一支军队能走多远。\n营帐里有补给、医治、休整，也有明天的计划。",
"res://Resources/DataFiles/shield.tres": "盾牌举起时，退路便消失了。\n他们不一定赢，但他们让别人有机会赢。",
"res://Resources/DataFiles/soldier.tres": "无名者，最先踏上战线。\n他们用纪律与队形，把混乱挡在身后。",
"res://Resources/DataFiles/han_caiguan.tres": "汉家材官，选锋之卒。\n执兵如林，以阵为刃，步步推进。",
"res://Resources/DataFiles/junguo_bing.tres": "不是精锐，却是郡县能调得出的全部。",
"res://Resources/DataFiles/yulin_lang.tres": "禁中精锐，披甲入夜，刀光不问姓名。",
"res://Resources/DataFiles/shesheng_shi.tres": "弦响如裂帛。箭落时，已无人能指认是谁放的。",
"res://Resources/DataFiles/sanhe_qishi.tres": "河内、河东、河南出良骑。马快，人也快。",
"res://Resources/DataFiles/changshui_huqi.tres": "胡骑善射，入阵如风，撤退更快。",
"res://Resources/DataFiles/cangtian_qimin.tres": "乱世里被抛下的人，最终只剩一条路：向天祈求，向世复仇。",
"res://Resources/DataFiles/huangjin_lishi.tres": "以血与土为誓，肩扛粗木，足踏乱军。",
"res://Resources/DataFiles/taiping_daoshi.tres": "符水与咒声不分善恶，能让人站起来的，就是天意。",
"res://Resources/DataFiles/ezei_youqi.tres": "来去如风，黄布遮面，马蹄掠过便只剩尘土。",
"res://Resources/DataFiles/cao_cao.tres": "治世之能臣，乱世之奸雄。此刻的他，满怀报国之志，却已看透朝堂的腐朽。",
"res://Resources/DataFiles/liu_bei.tres": "虽织席贩履，心怀天下。仁德是他最锋利的武器。",
"res://Resources/DataFiles/guan_yu.tres": "身长九尺，髯长二尺。丹凤眼一睁，便是人头落地之时。",
"res://Resources/DataFiles/zhang_fei.tres": "燕人张翼德在此！谁敢来决死战？",
"res://Resources/DataFiles/zhang_jiao.tres": "苍天已死，黄天当立！岁在甲子，天下大吉！",
"res://Resources/DataFiles/zhang_bao.tres": "地公将军，善使妖法，乱人心智。",
"res://Resources/DataFiles/zhang_liang.tres": "人公将军，统帅黄巾力士，力大无穷。",
"res://Resources/DataFiles/ma_yuanyi.tres": "黄巾渠帅，潜伏洛阳，意图里应外合。",
"res://Resources/DataFiles/bo_cai.tres": "统领颍川黄巾，曾大败朱儁，围皇甫嵩于长社。",
"res://Resources/DataFiles/danyang_bing.tres": "丹阳山险，民多果劲。天下精兵，出丹阳。",
"res://Resources/DataFiles/sun_jian.tres": "江东猛虎，古锭刀下无冤魂。他总是冲在最前线，因为他相信只有鲜血才能洗清乱世。"
}
